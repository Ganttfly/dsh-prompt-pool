{
  "name": "dsh-prompt-pool",
  "version": "1.0.4",
  "private": false,
  "description": "A prompt staging pool beside the DSH composer: capture drafts, arrange a playlist, release it into the queue.",
  "license": "MIT",
  "author": "GanttShen",
  "type": "module",
  "icon": "icon.svg",
  "homepage": "https://github.com/Ganttfly/dsh-prompt-pool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganttfly/dsh-prompt-pool.git"
  },
  "bugs": {
    "url": "https://github.com/Ganttfly/dsh-prompt-pool/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt",
    "queue",
    "composer",
    "ui"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
